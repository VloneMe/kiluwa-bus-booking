# Production only: call basipoa.co.tz through our own Nginx at /bp/
# (Nginx forwards /bp/ to https://basipoa.co.tz/ and passes HostGator's bot check).
# Overrides the same keys in .env.local when running 'vite build'.
VITE_API_KEY_BUSROUTES=/bp/manifest/utsrequest_by_company.php?company_id=17
VITE_API_KEY_BUSROUTES_TODAY=/bp/manifest/utsrequest_by_company_today.php?company_id=17
VITE_API_KEY_BUSES_SEARCHED=/bp/manifest/utsrequest_by_company_search.php?company_id=17
VITE_API_KEY_BUSBYID=/bp/manifest/journeys.php?idc=
VITE_API_TICKET=/bp/buspoa/website/Payment/getTicketJson/
VITE_API_KEY_LOGIN=/bp/users/user_login.php
VITE_API_KEY_REGISTER=/bp/users/register_user.php
VITE_API_KEY_UPDATE_PWD=/bp/users/update_password.php
VITE_API_KEY_PROFILE=/bp/users/user_profile.php
VITE_API_KEY_UPDATE_PROFILE=/bp/users/update_user.php
VITE_API_KEY_passengerdata=/bp/manifest/from_app_two.php
